{
  "expo": {
    "name": "SmartPantry",
    "slug": "SmartPantry",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartpantry",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./assets/locales/en.json",
      "sk": "./assets/locales/sk.json",
      "ru": "./assets/locales/ru.json",
      "uk": "./assets/locales/uk.json",
      "hu": "./assets/locales/hu.json"
    },
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.nerorebel.smartpantry",
      "versionCode": 2,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      ["expo-status-bar", { "hidden": false, "style": "light" }],
      ["expo-navigation-bar", { "enforceContrast": false, "hidden": false, "style": "light" }],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-localization",
      "expo-notifications",
      ["expo-image-picker", {
        "photosPermission": "Allow SmartPantry to access photos you choose for your profile.",
        "microphonePermission": false
      }],
      ["expo-camera", {
        "cameraPermission": "Allow SmartPantry to use your camera to scan food product barcodes.",
        "microphonePermission": false,
        "recordAudioAndroid": false,
        "barcodeScannerEnabled": true
      }],
      "./plugins/with-release-android.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
